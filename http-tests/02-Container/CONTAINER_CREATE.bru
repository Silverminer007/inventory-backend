meta {
  name: CONTAINER_CREATE
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v2/sync/applyCommands?head={{head}}
  body: json
  auth: none
}

params:query {
  head: {{head}}
}

docs {
  Container Test 1: CONTAINER_CREATE under root -> succeeds.
  Stores the new container id in `containerId` and advances `head`.
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar('cmdId', uuid());
  bru.setVar('containerId', uuid());
}

body:json {
  [
    {
      "parent": "{{head}}",
      "child": null,
      "command": {
        "id": "{{cmdId}}",
        "command_type": "CONTAINER_CREATE",
        "command_version": 1,
        "payload": {
          "id": "{{containerId}}",
          "name": "Garage Shelf A",
          "parent": "{{rootId}}",
          "created_at": "2000-01-01T00:00:00",
          "type": "SHELF",
          "position": "north wall"
        }
      }
    }
  ]
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar('head', res.getBody());
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}