meta {
  name: Command - invalid command_version (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v2/sync/applyCommands?head={{head}}
  body: json
  auth: none
}

params:query {
  head: {{head}}
}

docs {
  Command Test 3: a valid command_type with command_version = 2 -> fails (400).
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar('cmdId', uuid());
  bru.setVar('containerId', uuid());
}

body:json {
  [
    {
      "parent": "{{head}}",
      "child": null,
      "command": {
        "id": "{{cmdId}}",
        "command_type": "CONTAINER_CREATE",
        "command_version": 2,
        "payload": {
          "id": "{{containerId}}",
          "name": "Future Version Container",
          "parent": "{{rootId}}",
          "created_at": "2000-01-01T00:00:00"
        }
      }
    }
  ]
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}