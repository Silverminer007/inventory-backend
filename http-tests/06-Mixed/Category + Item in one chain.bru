meta {
  name: Category + Item in one chain
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v2/sync/applyCommands?head={{head}}
  body: json
  auth: none
}

params:query {
  head: {{head}}
}

docs {
  Mixed Test 4: CATEGORY_CREATE -> ITEM_CREATE (category) applied atomically in a
  single request. Demonstrates the in-request linked list: the first entry's
  parent is the current head, the second entry's parent is the first command's id,
  and each entry points to its child. The server applies all-or-nothing.
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar('catCmdId', uuid());
  bru.setVar('itemCmdId', uuid());
  bru.setVar('categoryId', uuid());
  bru.setVar('itemId', uuid());
}

body:json {
  [
    {
      "parent": "{{head}}",
      "child": "{{itemCmdId}}",
      "command": {
        "id": "{{catCmdId}}",
        "command_type": "CATEGORY_CREATE",
        "command_version": 1,
        "payload": {
          "id": "{{categoryId}}",
          "name": "Fasteners",
          "shortcode": "FST",
          "created_at": "2000-01-01T00:00:00"
        }
      }
    },
    {
      "parent": "{{catCmdId}}",
      "child": null,
      "command": {
        "id": "{{itemCmdId}}",
        "command_type": "ITEM_CREATE",
        "command_version": 1,
        "payload": {
          "id": "{{itemId}}",
          "name": "M6 Bolts",
          "container": "{{rootId}}",
          "quantity": 200,
          "created_at": "2000-01-01T00:00:00",
          "category": "{{categoryId}}"
        }
      }
    }
  ]
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar('head', res.getBody());
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("head is the last command in the chain", function () {
    expect(res.getBody()).to.equal(bru.getVar('itemCmdId'));
  });
}