meta {
  name: ITEM_CREATE - unknown container (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v2/sync/applyCommands?head={{head}}
  body: json
  auth: none
}

params:query {
  head: {{head}}
}

docs {
  Item Test 12: ITEM_CREATE with a valid-but-non-existent container UUID -> fails (400).
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar('cmdId', uuid());
  bru.setVar('itemId', uuid());
}

body:json {
  [
    {
      "parent": "{{head}}",
      "child": null,
      "command": {
        "id": "{{cmdId}}",
        "command_type": "ITEM_CREATE",
        "command_version": 1,
        "payload": {
          "id": "{{itemId}}",
          "name": "Orphan Item",
          "container": "99999999-9999-9999-9999-999999999999",
          "quantity": 1,
          "created_at": "2000-01-01T00:00:00"
        }
      }
    }
  ]
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}